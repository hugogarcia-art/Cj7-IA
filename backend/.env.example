# ─── Base de datos (Supabase / Postgres) ───────────────────────────────
# Con pooler (pgbouncer) para la app:
DATABASE_URL="postgresql://usuario:password@host:6543/postgres?pgbouncer=true"
# Conexion directa, la usa `prisma db push` / `migrate`:
DIRECT_URL="postgresql://usuario:password@host:5432/postgres"

# ─── Autenticacion ─────────────────────────────────────────────────────
# OBLIGATORIA. Generala con: openssl rand -base64 48
# Si cambia, todas las sesiones abiertas se invalidan.
JWT_SECRET=""
JWT_EXPIRES_IN="1d"

# ─── CORS: de donde se permite llamar a esta API ───────────────────────
# localhost:3000 siempre esta permitido. Aqui van las URLs de produccion,
# separadas por coma y SIN barra final.
FRONTEND_URLS="https://tu-app.vercel.app"

# ─── OpenAI ────────────────────────────────────────────────────────────
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# ─── Supabase Storage (imagenes de producto) ───────────────────────────
SUPABASE_URL=""
# Usa la service_role key: solo vive en el servidor, nunca en el frontend.
SUPABASE_KEY=""
SUPABASE_BUCKET="cj7-productos"

# ─── WhatsApp Cloud API (Meta) ─────────────────────────────────────────
# El que escribes en el panel de Meta al dar de alta el webhook.
WHATSAPP_VERIFY_TOKEN=""
# App Secret de Meta: valida la firma X-Hub-Signature-256 del webhook.
# Sin el, cualquiera puede inyectar mensajes falsos y gastar tu credito.
META_APP_SECRET=""
META_TOKEN=""
PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
APP_ID=""
# Cuenta a la que se asignan los contactos que entran por WhatsApp.
# Si se deja vacio, se usa la cuenta mas antigua.
WHATSAPP_OWNER_EMAIL=""

# ─── Cola de mensajes (opcional, modulo desactivado) ───────────────────
# URL completa de Redis, incluidas credenciales. Vacio = cola deshabilitada.
REDIS_URL=""

# ─── Servidor ──────────────────────────────────────────────────────────
PORT=8765
