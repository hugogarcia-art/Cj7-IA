generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         String    @id @default(uuid())
  email      String    @unique
  username   String    @unique
  /// Hash bcrypt. Nunca la contraseña en claro.
  password   String
  fullName   String?
  gender     String?
  clientCode Int       @unique
  bio        String?
  role       String    @default("USER")
  createdAt  DateTime  @default(now())
  clients    Client[]
  products   Product[]
}

model Client {
  id          String    @id @default(uuid())
  name        String
  /// Solo dígitos. Único por cuenta, no a nivel global.
  phone       String
  email       String?
  tags        String[]
  status      String    @default("Nuevo")
  notes       String?
  lastContact DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  sales       Sale[]

  @@unique([userId, phone])
  @@index([userId, createdAt])
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String?
  /// Único por cuenta: dos negocios pueden usar el mismo SKU.
  sku         String
  price       Float
  offerPrice  Float?
  cost        Float?
  stock       Int      @default(0)
  minStock    Int      @default(0)
  imageUrl    String?
  status      String   @default("Activo")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  @@unique([userId, sku])
  @@index([userId, createdAt])
}

model Sale {
  id        String   @id @default(uuid())
  total     Float
  status    String   @default("Pendiente")
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String

  @@index([clientId])
}

model Message {
  id        String   @id @default(uuid())
  phone     String
  sender    String // "user" o "ai"
  content   String
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}
