generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  username    String   @unique
  password    String
  fullName    String?
  gender      String?
  clientCode  Int      @unique
  bio         String?
  role        String   @default("USER")
  remarketingEnabled Boolean @default(false)
  createdAt   DateTime @default(now())
  clients     Client[]
  products    Product[]
  campaigns   Campaign[]
  automations Automation[] 
}

model Client {
  id          String    @id @default(uuid())
  name        String
  /// Solo dígitos. Único por cuenta, no a nivel global.
  phone       String
  email       String?
  tags        String[]
  status      String    @default("Nuevo")
  notes       String?
  lastContact DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  sales       Sale[]

  @@unique([userId, phone])
  @@index([userId, createdAt])
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String?
  /// Único por cuenta: dos negocios pueden usar el mismo SKU.
  sku         String
  price       Float
  offerPrice  Float?
  cost        Float?
  stock       Int      @default(0)
  minStock    Int      @default(0)
  imageUrl    String?
  extraImages String[]
  status      String   @default("Activo")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  @@unique([userId, sku])
  @@index([userId, createdAt])
}

model Sale {
  id            String     @id @default(uuid())
  total         Float
  status        String     @default("Nuevo") // Nuevo, Pendiente, En Proceso, Pagado, Enviado, Completado, Cancelado
  paymentMethod String?
  notes         String?
  createdAt     DateTime   @default(now())
  clientId      String
  client        Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model Message {
  id        String   @id @default(uuid())
  phone     String
  sender    String // "user" o "ai"
  content   String
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

model Campaign {
  id             String    @id @default(uuid())
  name           String
  message        String
  imageUrl       String?   // Imagen de la campaña (Supabase)
  audience       String    @default("todos")
  status         String    @default("borrador") // borrador | programada | enviando | completada
  scheduledAt    DateTime? // Fecha/hora programada del envío
  recurrenceDays Int?      // Si se define: se repite cada X días
  totalSent      Int       @default(0)
  totalFailed    Int       @default(0)
  totalOpened    Int       @default(0)
  createdAt      DateTime  @default(now())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
}
model Automation {
  id        String   @id @default(uuid())
  type      String   @unique @default("remarketing_3_dias")
  enabled   Boolean  @default(false) // Interruptor ON/OFF
  daysThreshold Int  @default(3)     // Cada cuántos días
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}
