{
  "extends": "./tsconfig.json",
  // `scripts/` son utilidades de mantenimiento que se ejecutan con ts-node.
  // Si entran al build, TypeScript pasa a emitir dist/src/main.js en vez de
  // dist/main.js y `npm run start:prod` deja de encontrar el entrypoint.
  "exclude": ["node_modules", "test", "dist", "scripts", "**/*spec.ts"]
}
